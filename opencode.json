{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "justwoker": {
      "name": "JustWoker",
      "npm": "@ai-sdk/anthropic",
      "options": {
        "baseURL": "https://api.justwoker.icu/v1",
        "apiKey": "{env:JUSTWOKER_API_KEY}"
      },
      "models": {
        "gpt-5.6-sol": {
          "name": "GPT-5.6 SOL"
        }
      }
    }
  },
  "vyceai": {
    "npm": "@ai-sdk/openai-compatible",
    "name": "vyceai",
    "options": {
      "baseURL": "https://vyceai.com/v1"
    },
    "models": {
      "deepseek-v4-flash": {
        "name": "deepseek-v4-flash",
        "variants": {
          "low": {
            "reasoningEffort": "low"
          },
          "medium": {
            "reasoningEffort": "medium"
          },
          "high": {
            "reasoningEffort": "high"
          }
        }
      },
      "claude-sonnet-4-6": {
        "name": "claude-sonnet-4-6",
        "variants": {
          "low": {
            "reasoningEffort": "low"
          },
          "medium": {
            "reasoningEffort": "medium"
          },
          "high": {
            "reasoningEffort": "high"
          }
        }
      }
    }
  },
  "model": "justwoker/gpt-5.6-sol",
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 15000
    },
    "buffer": 30000
  }
}