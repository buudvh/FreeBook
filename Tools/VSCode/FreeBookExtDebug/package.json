{
  "name": "freebook-extdebug",
  "displayName": "FreeBook Extension Debug",
  "description": "Chạy execute(...) của VBook extension trên app FreeBook đang mở trên iPhone/iPad cùng mạng LAN, và xem trace console/fetch/exception ngay trong VS Code.",
  "version": "0.1.0",
  "publisher": "freebook",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Debuggers", "Other"],
  "activationEvents": [],
  "main": "./out/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Cần workspace tin cậy vì extension đọc plugin.json và gửi mã nguồn sang thiết bị."
    }
  },
  "contributes": {
    "commands": [
      { "command": "freebook.extdebug.pair", "title": "FreeBook: Pair with App", "category": "FreeBook" },
      { "command": "freebook.extdebug.selectExtension", "title": "FreeBook: Select Extension", "category": "FreeBook" },
      { "command": "freebook.extdebug.runCurrent", "title": "FreeBook: Run Current execute", "category": "FreeBook" },
      { "command": "freebook.extdebug.runScript", "title": "FreeBook: Run Script…", "category": "FreeBook" },
      { "command": "freebook.extdebug.runProfile", "title": "FreeBook: Run Saved Profile", "category": "FreeBook" },
      { "command": "freebook.extdebug.stageDraft", "title": "FreeBook: Stage Workspace Draft", "category": "FreeBook" },
      { "command": "freebook.extdebug.installDraft", "title": "FreeBook: Install Staged Draft (needs device approval)", "category": "FreeBook" },
      { "command": "freebook.extdebug.rollback", "title": "FreeBook: Rollback Installed Extension", "category": "FreeBook" },
      { "command": "freebook.extdebug.cancelRun", "title": "FreeBook: Cancel Current Run", "category": "FreeBook" },
      { "command": "freebook.extdebug.openTrace", "title": "FreeBook: Open Trace", "category": "FreeBook" }
    ],
    "configuration": {
      "title": "FreeBook Extension Debug",
      "properties": {
        "freebook.extdebug.defaultPage": {
          "type": "number",
          "default": 1,
          "description": "Số trang mặc định cho profile search/custom."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "@types/ws": "^8.5.12",
    "typescript": "^5.5.0"
  }
}
