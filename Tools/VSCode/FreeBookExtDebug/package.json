{
  "name": "freebook-ext-debug",
  "displayName": "FreeBook Extension Debug",
  "description": "Debug VBook execute(...) scripts through the FreeBook iOS app.",
  "version": "0.1.0",
  "publisher": "freebook-internal",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:freebookExtDebug.openPanel",
    "onView:freebookExtDebug.sidebar",
    "onCommand:freebookExtDebug.pair",
    "onCommand:freebookExtDebug.selectExtensionRoot",
    "onCommand:freebookExtDebug.runCurrent",
    "onCommand:freebookExtDebug.runSavedProfile",
    "onCommand:freebookExtDebug.useMockTransport",
    "onCommand:freebookExtDebug.cancelRun",
    "onCommand:freebookExtDebug.openTrace"
  ],
  "main": "./out/extension.js",
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "freebookExtDebug.openPanel",
        "title": "Open FreeBook Debug",
        "icon": "media/freebook-debug.svg"
      },
      {
        "command": "freebookExtDebug.pair",
        "title": "Pair with FreeBook App"
      },
      {
        "command": "freebookExtDebug.selectExtensionRoot",
        "title": "Select Extension Root"
      },
      {
        "command": "freebookExtDebug.runCurrent",
        "title": "Run Current execute"
      },
      {
        "command": "freebookExtDebug.runSavedProfile",
        "title": "Run Saved Profile"
      },
      {
        "command": "freebookExtDebug.useMockTransport",
        "title": "Use Mock Transport"
      },
      {
        "command": "freebookExtDebug.cancelRun",
        "title": "Cancel Current Run"
      },
      {
        "command": "freebookExtDebug.openTrace",
        "title": "Open Trace"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "freebookExtDebug",
          "title": "FreeBook Debug",
          "icon": "media/freebook-debug.svg"
        }
      ]
    },
    "views": {
      "freebookExtDebug": [
        {
          "type": "webview",
          "id": "freebookExtDebug.sidebar",
          "name": "Extension Debug"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "command": "freebookExtDebug.openPanel",
          "when": "resourceExtname == .js",
          "group": "navigation@50"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "check": "tsc -p . --noEmit",
    "package": "npm run compile && vsce package --allow-missing-repository"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/vscode": "^1.85.0",
    "@types/ws": "^8.5.13",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.7.3"
  }
}
